 * @link https://brocode.at
 *
 * The schema change carried here is the one proposed upstream by @stormbyte in
 * magento/magento2#33191 ("Make sku unique", closed unmerged 2022-10-25), which
 * fixes magento/magento2#31125. That PR removed the non-unique btree index on
 * catalog_product_entity.sku and replaced it with a unique constraint. This module
 * expresses the same change from the outside, since a third-party module cannot
 * delete another module's index node and must disable it instead.
 */
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="catalog_product_entity" resource="default" engine="innodb">
        <constraint xsi:type="unique" referenceId="CATALOG_PRODUCT_ENTITY_SKU">
            <column name="sku"/>
        </constraint>
        <index referenceId="CATALOG_PRODUCT_ENTITY_SKU" indexType="btree" disabled="true">
            <column name="sku"/>
        </index>
    </table>
</schema>
